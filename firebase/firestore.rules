rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function organization(orgId) {
      return get(orgPath(orgId)).data;
    }

    function membership(orgId) {
      return get(memberPath(orgId)).data;
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(orgPath(orgId))
        && exists(memberPath(orgId))
        && organization(orgId).status != 'suspended'
        && membership(orgId).active == true;
    }

    function orgRole(orgId) {
      return membership(orgId).role;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) == 'admin';
    }

    function canWriteFarm(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['admin', 'manager', 'staff'];
    }

    function canManageFinance(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['admin', 'manager'];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['activeOrgId', 'updatedAt', 'lastLoginAt']);
      allow create, delete: if false;

      match /organizations/{orgId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create, delete: if false;
      allow update: if isOrgAdmin(orgId);

      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /pigs/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /pigEvents/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /feedLogs/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /feedPurchases/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /feedSettings/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /weightRecords/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /monthlyInputs/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canWriteFarm(orgId);
      }

      match /transactions/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canManageFinance(orgId);
      }

      match /liabilities/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if canManageFinance(orgId);
      }
    }
  }
}
